% pelm.sty — shared style for Prompt Engineering and Large Language Models
% assessments (quizzes, midterm, final, makeup).
%
% Usage:
%   \documentclass[11pt,a4paper]{article}
%   \usepackage{pelm}
%   \paper{Quiz 1}{Weeks 1--2: Introduction and History}{10}{10 minutes}
%   \begin{questions}
%     \q{Stem?}{Option A}{Option B}{Option C}{Option D}
%   \end{questions}
%
% Answer keys use \key{B}{Explanation.}

\ProvidesPackage{pelm}

\usepackage[utf8]{inputenc}
\usepackage[T1]{fontenc}
\usepackage{lmodern}
\usepackage{geometry}
\usepackage{enumitem}
\usepackage{fancyhdr}
\geometry{margin=1in, top=0.9in, bottom=0.9in}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\small\thepage}

% \paper{title}{coverage}{number of questions}{duration}
\newcommand{\paper}[4]{%
  \begin{center}
    {\LARGE\bfseries Prompt Engineering and Large Language Models}\\[4pt]
    {\Large #1}\\[6pt]
    {\normalsize #2}\\[10pt]
    {\small Name: \underline{\hspace{5.5cm}} \quad Student No: \underline{\hspace{3.5cm}} \quad Date: \underline{\hspace{2.5cm}}}
  \end{center}
  \vspace{0.35cm}
  \noindent\textbf{Instructions.} This paper contains #3 multiple-choice questions.
  Select the \textbf{single best} answer for each. Each question is worth equal marks.
  Time allowed: #4. No notes or electronic devices.
  \vspace{0.35cm}\hrule\vspace{0.45cm}
}

% \answerpaper{title}{coverage}
\newcommand{\answerpaper}[2]{%
  \begin{center}
    {\LARGE\bfseries Answer Key}\\[4pt]
    {\Large #1}\\[6pt]
    {\normalsize #2}
  \end{center}
  \vspace{0.35cm}\hrule\vspace{0.45cm}
}

\newenvironment{questions}
  {\begin{enumerate}[leftmargin=*, itemsep=0.55em, label=\textbf{\arabic*.}]}
  {\end{enumerate}}

% \q{stem}{A}{B}{C}{D}
\newcommand{\q}[5]{%
  \item #1
  \begin{enumerate}[label=\Alph*), itemsep=0.1em, topsep=0.25em, leftmargin=1.4em]
    \item #2
    \item #3
    \item #4
    \item #5
  \end{enumerate}
}

% \key{letter}{explanation}
\newcommand{\key}[2]{\item \textbf{#1} \quad #2}

\endinput
